{
  "name": "dsh-subagent-station",
  "version": "0.4.0",
  "description": "子智能体派出所：按岗位绑定模型路由的受控子智能体派出插件。派出时校验岗位权限，并在子会话的每一轮模型请求上把路由压回批准值。",
  "type": "module",
  "main": "lib/host/index.js",
  "icon": "icon.svg",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "model-routing",
    "policy"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/host/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none \"tests/unit/*.test.js\"",
    "test:contract": "node tests/contract/c1-define-tool.mjs",
    "proof:red": "node scripts/make-red-proof.mjs",
    "report": "node scripts/report.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-scope": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
